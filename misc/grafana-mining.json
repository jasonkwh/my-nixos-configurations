    {
      "id": 1,
      "type": "stat",
      "title": "Hashrate",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "unit": "suffix:TH/s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bitaxe_hashrate_1h) / 1000",
          "instant": true
        }
      ],
      "description": "1h average across every Bitaxe on the LAN."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Efficiency",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "suffix:J/TH"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bitaxe_power) / (sum(bitaxe_hashrate_1h) > 0) * 1000",
          "instant": true
        }
      ],
      "description": "Fleet watts per TH/s, from the 1h hashrate."
    },
