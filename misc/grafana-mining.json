    {
      "id": 9,
      "type": "table",
      "title": "Stratum Pool",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Role"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "active": {
                        "text": "ACTIVE",
                        "color": "green"
                      },
                      "idle": {
                        "text": "idle",
                        "color": "text"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(bitaxe_pool_info and on() (bitaxe_using_fallback == 0), \"role\", \"active\", \"url\", \".+\") or label_replace(bitaxe_fallback_pool_info and on() (bitaxe_using_fallback == 1), \"role\", \"active\", \"url\", \".+\") or label_replace(bitaxe_pool_info and on() (bitaxe_using_fallback == 1), \"role\", \"idle\", \"url\", \".+\") or label_replace(bitaxe_fallback_pool_info and on() (bitaxe_using_fallback == 0), \"role\", \"idle\", \"url\", \".+\")",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            },
            "renameByName": {
              "role": "Role",
              "url": "Pool URL",
              "port": "Port",
              "protocol": "Protocol"
            },
            "indexByName": {
              "Role": 0,
              "Pool URL": 1,
              "Port": 2,
              "Protocol": 3
            }
          }
        }
      ]
    },
