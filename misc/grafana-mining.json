        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "suffix:J/TH",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 18,
                "color": "orange"
              },
              {
                "value": 25,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(bitaxe_power) / (sum(bitaxe_hashrate_10m) > 0) * 1000",
          "instant": true
        }
