    {
      "id": 1,
      "type": "stat",
      "title": "Hashrate (TH/s, 1h avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prometheus}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "unit": "suffix:TH/s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bitaxe_hashrate_1h / 1000",
          "instant": true
        }
      ]
    },
    {
